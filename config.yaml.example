# Nova Agent Configuration

# LLM API — any OpenAI-compatible endpoint
# Examples:
#   OpenRouter:  base_url: "https://openrouter.ai/api/v1"
#   DeepSeek:    base_url: "https://api.deepseek.com/v1"
#   OpenAI:      base_url: "https://api.openai.com/v1"
#   Ollama:      base_url: "http://localhost:11434/v1"
llm:
  provider: "openai"             # OpenAI-compatible endpoints only
  api_key: "${LLM_API_KEY}"   # or set LLM_API_KEY env var (OPENROUTER_API_KEY also accepted)
  model: "qwen/qwen3.6-flash" # Any model supported by your endpoint
  base_url: "https://openrouter.ai/api/v1"
  # Optional OpenRouter reasoning controls, for example: {enabled: true}
  # reasoning:
  #   enabled: true

# Web tools — Firecrawl (search, scrape, map, crawl, extract, parse)
# Requires: pip install 'nova-agent[web]' and an API key from firecrawl.dev.
# Without a key the web tools are not registered at all (saves ~1.7k tokens
# of tool schema on every request).
web:
  enabled: true
  firecrawl_api_key: "${FIRECRAWL_API_KEY}"
  timeout_seconds: 30

# Agent settings
agent:
  identity: "You are Nova, a helpful personal assistant."
  max_iterations: 50          # Max tool calls per turn
  temperature: 0.7
  top_p: 1.0
  stream_include_usage: true    # Include token usage in streaming responses

# Token budgets (explicit caps at every layer)
budgets:
  system_prompt_max: 16000          # Total system prompt tokens
  skills_max_chars: 15000           # Skills section character limit
  skills_max_count: 50              # Max skills in prompt
  context_file_max_chars: 10000     # Per context file
  context_total_max_chars: 50000    # Total across all context files
  tool_result_max_chars: 8000       # Per tool result
  tool_result_max_tokens: 12000     # Token cap per tool result
  conversation_turn_limit: 15       # DM session turn limit before compression

# Context files to discover (project-level context, in priority order)
# Note: Global personality file (~/.nova/SOUL.md) is loaded separately via load_global_personality()
context_files:
  - "NOVA.md"
  - "AGENTS.md"

# Wiki memory (Obsidian-compatible vault)
# - Notes in Core/ get full content auto-injected into every prompt
# - All other notes appear as a compact recent-notes index
# - Vault path is openable directly in Obsidian
wiki:
  enabled: true
  vault_path: "~/.nova/wiki"
  max_prompt_notes: 10

# Skills
skills:
  enabled: true
  directory: "~/.nova/skills"

# Session storage
session:
  enabled: true
  directory: "~/.nova/sessions"

# Logging
logging:
  level: "INFO"
  file: "~/.nova/nova.log"

# Sub-agent delegation
# Allows the agent to spawn child agents for isolated or parallelizable tasks.
delegation:
  enabled: false                  # Set to true to enable delegate_task tool
  max_spawn_depth: 2              # Max nesting depth (0=root only, 2=root→child→grandchild)
  default_timeout_seconds: 60     # Default sub-agent timeout

  # Budget overrides for sub-agents (smaller than parent defaults)
  subagent_budgets:
    max_iterations: 30            # Max tool calls per sub-agent turn
    system_prompt_max: 8000       # Smaller system prompt for sub-agents
    tool_result_max_chars: 4000   # Smaller tool result budget
    tool_result_max_tokens: 4000  # Token limit per tool result

# Permission system — tool execution approval with defense-in-depth
# Modes: "ask" (confirm mutating tools, current default) or "auto" (allow all)
permissions:
  mode: "ask"                     # "ask" or "auto"
  denied_tools: []                # Tools the agent can never use
  allowed_tools: []               # Tools that bypass confirmation (ask mode)
  denied_commands: []             # Shell command patterns that are always blocked (fnmatch patterns)
  path_rules: []                  # Path-level allow/deny rules (fnmatch patterns)
    # Example:
    # - pattern: "/etc/*"
    #   allow: false

# MCP (Model Context Protocol) — connect to external tool servers
# Supports three transport types: stdio (local), http (Streamable HTTP), sse (Server-Sent Events)
mcp:
  servers: {}
    # Example: Local filesystem server (stdio — default when command is present)
    # filesystem:
    #   type: stdio
    #   command: npx
    #   args: ["-y", "@modelcontextprotocol/server-filesystem", "/path/to/dir"]
    #   deferred: true  # Connect on explicit discovery; requires tool_catalog.enabled
    #   description: "Search and edit files in the configured directory"

    # Example: Remote API server (Streamable HTTP)
    # remote-api:
    #   type: http
    #   url: https://api.example.com/mcp
    #   headers:
    #     Authorization: "Bearer ${API_TOKEN}"
    #   timeout: 30.0

    # Example: SSE-based server
    # sse-server:
    #   type: sse
    #   url: https://api.example.com/sse
    #   post_url: https://api.example.com/post  # optional, defaults to url
    #   headers:
    #     Authorization: "Bearer ${API_TOKEN}"
    #   timeout: 30.0

    # Example: GitHub server (stdio with env vars)
    # github:
    #   type: stdio
    #   command: npx
    #   args: ["-y", "@modelcontextprotocol/server-github"]
    #   env:
    #     GITHUB_PERSONAL_ACCESS_TOKEN: "${GITHUB_TOKEN}"

# Cost tracking — token counts and dollar costs per session
cost_tracking:
  enabled: true                   # Track usage and estimate costs

# Microcompact — cheap context window reduction (Tier 1 compaction)
# Strips old tool result content while preserving message structure
microcompact:
  enabled: true                   # Enable microcompact before LLM-based compression
  keep_recent: 6                  # Number of recent messages to preserve fully

# Retry logic — API call resilience
retry:
  max_retries: 3                  # Max retry attempts for transient errors
  base_delay: 1.0                 # Initial delay in seconds (exponential backoff)
  max_delay: 60.0                 # Maximum delay cap

# Optional observability (disabled by default; provider: langfuse or mlflow)
observability:
  enabled: false
  provider: langfuse
  sample_rate: 1.0
  capture_input: false
  capture_output: false
  mlflow:
    tracking_uri: "http://127.0.0.1:5000"
    experiment: "nova-agent"
  langfuse:
    public_key: "${LANGFUSE_PUBLIC_KEY}"
    secret_key: "${LANGFUSE_SECRET_KEY}"
    base_url: "${LANGFUSE_BASE_URL}"
    flush_at_shutdown: true

# Keep full schemas for small catalogs; discover and activate tools when larger.
tool_catalog:
  enabled: true
  schema_max_tokens: 4096
