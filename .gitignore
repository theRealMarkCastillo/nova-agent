# Byte-compiled / optimized / distribution files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/

# Ruff
.ruff_cache/

# Nova runtime data (memory, sessions, logs)
memory.json
*.db
*.jsonl
*.log
logs/

# Config (user-specific)
config.yaml
.env

# OS
.DS_Store
Thumbs.db

# Share only portable Entire settings/hooks; keep other agent state local.
!/.agents/
/.agents/*
!/.agents/hooks.json
!/.claude/
/.claude/*
!/.claude/settings.json
!/.codex/
/.codex/*
!/.codex/hooks.json
!/.opencode/
/.opencode/*
!/.opencode/plugins/
/.opencode/plugins/*
!/.opencode/plugins/entire.ts

# Entire's nested ignore file excludes its runtime data and personal settings.
!/.entire/
/.entire/*
!/.entire/.gitignore
!/.entire/settings.json
!/.entire/redactors/

# mypy
.mypy_cache/

# Logs
*.log
logs/
memory/
